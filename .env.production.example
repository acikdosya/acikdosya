# Sunucudaki dagitim ayarlari icin ornek. .env.deploy olarak kopyalanir,
# o dosya git'te durmaz.
#
# SITE_URL ve CONTACT_EMAIL DERLEME zamaninda imaja gomulur; scripts/deploy.sh
# onlari build arg olarak gecirir. Konteyneri yeniden baslatmak degistirmez,
# imajin yeniden derlenmesi gerekir.

# Sitenin mutlak adresi. canonical, hreflang, OG ve AR adresleri buradan turer.
SITE_URL=https://acikdosya.org

# Duzeltme ve iletisim adresi. Bos birakilirsa lib/config.ts icindeki
# yayimlanmis adres kullanilir; uydurma adres uretilmez.
CONTACT_EMAIL=info@acikdosya.org

# Dagitim hedefi. Gercek degerler deploy/RUNBOOK.md defterinde durur
# (o dosya git'te yok, ornegi deploy/RUNBOOK.example.md).
DEPLOY_HOST=kullanici@sunucu-adresi
DEPLOY_DIR=/opt/<uygulama-dizini>

# Uygulamanin sunucudaki loopback portu. compose.yaml bunu sunucuya birakilan
# .env uzerinden okur; nginx vhost'undaki __APP_PORT__ yer tutucusu da ayni
# degeri ister. Disariya acilmaz, yalnizca 127.0.0.1.
APP_PORT=

# Olcum site kimligi. Umami panelinden alinir (ssh tuneli, bkz.
# deploy/RUNBOOK.md). Bos birakilirsa olcum kapali bir imaj cikar.
# DERLEME zamaninda gomulur.
UMAMI_WEBSITE_ID=
