# Sunucudaki dagitim ayarlari icin ornek. .env.deploy olarak kopyalanir,
# o dosya git'te durmaz.
#
# SITE_URL ve CONTACT_EMAIL DERLEME zamaninda imaja gomulur; scripts/deploy.sh
# onlari build arg olarak gecirir. Konteyneri yeniden baslatmak degistirmez,
# imajin yeniden derlenmesi gerekir.

# Sitenin mutlak adresi. canonical, hreflang, OG ve AR adresleri buradan turer.
SITE_URL=https://acikdosya.org

# Duzeltme ve iletisim adresi. Bos birakilirsa hakkinda sayfasi kanalin
# yayimlanmadigini yazar; uydurma adres uretilmez.
CONTACT_EMAIL=

# Dagitim hedefi.
DEPLOY_HOST=root@46.62.206.100
DEPLOY_DIR=/opt/acikdosya
