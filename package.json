{
  "name": "tayfun",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"lib/**/*.test.tsx\" \"components/**/*.test.ts\" \"components/**/*.test.tsx\"",
    "bake:models": "node --import tsx scripts/bake-glb.mjs",
    "build:tiles": "node --import tsx scripts/build-tiles.mjs",
    "prebuild": "pnpm validate:content && pnpm bake:models"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.2",
    "maplibre-gl": "^5.24.1",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pmtiles": "^4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@protomaps/basemaps": "^5.7.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.4",
    "draco3dgltf": "1.5.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6"
  },
  "packageManager": "pnpm@10.29.3"
}
