# Olcum yigininin ayarlari. Sunucuda yiginin kurulu oldugu dizinde .env
# olarak durur; bu ornek disinda git'e girmez. Dizin ve port degerleri
# deploy/RUNBOOK.md icinde.
#
# Sirlari rastgele uret:
#   openssl rand -base64 32
#
# UMAMI_DB_PASSWORD sonradan degistirilirse veritabani kullanicisinin
# parolasi da elle degistirilmeli — konteyner ilk acilistan sonra
# POSTGRES_PASSWORD'u yeniden uygulamaz.

UMAMI_DB_PASSWORD=degistir-rastgele-uret
UMAMI_APP_SECRET=degistir-rastgele-uret

# Yonetim arayuzunun loopback portu. Yalnizca 127.0.0.1'e baglanir, panel
# ssh tuneliyle acilir. Deger runbook'ta.
UMAMI_PORT=
