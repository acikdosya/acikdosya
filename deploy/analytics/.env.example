# Olcum yigininin sirlari. Sunucuda /opt/acikdosya/analytics/.env olarak
# durur; bu ornek disinda git'e girmez.
#
# Ikisini de rastgele uret:
#   openssl rand -base64 32
#
# UMAMI_DB_PASSWORD sonradan degistirilirse veritabani kullanicisinin
# parolasi da elle degistirilmeli — konteyner ilk acilistan sonra
# POSTGRES_PASSWORD'u yeniden uygulamaz.

UMAMI_DB_PASSWORD=degistir-rastgele-uret
UMAMI_APP_SECRET=degistir-rastgele-uret
