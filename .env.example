# Sitenin mutlak adresi — canonical ve hreflang icin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Duzeltme ve iletisim adresi. Verilmezse lib/config.ts icindeki
# yayimlanmis adres kullanilir; uydurma adres uretilmez.
NEXT_PUBLIC_CONTACT_EMAIL=info@acikdosya.org

# Harita stili. Varsayilan kendi paketimiz: /tiles/style.json — pnpm build:tiles
# ile uretilir. Paketi uretmeden calisan bir kopyada haritayi baska bir stile
# yoneltmek icin doldur; yayinda bos kalir.
NEXT_PUBLIC_MAP_STYLE_URL=

# Harita atfi ortam degiskeni degil: kaynak listesi lib/config.ts icinde
# MAP_SOURCES olarak duruyor. Hem harita kontrolu hem altbilgi oradan okur.

# Olcum — kendi sunucumuzdaki Umami'nin site kimligi. Bos birakilirsa
# tarayici script'i hic basilmaz; yerelde olcum kapalidir.
NEXT_PUBLIC_UMAMI_ID=

# Olcum sunucusunun konteyner agindaki adresi. /veri altindaki istekler
# sunucu tarafinda buraya vekilleniyor (next.config.ts). Yerelde Umami
# calistirmiyorsan bos birak, varsayilan zaten http://umami:3000.
UMAMI_INTERNAL_URL=
